{
  "name": "stts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsdown && vite build",
    "check": "biome ci . && tsc --noEmit && npm test",
    "test": "markdownlint-cli2 && vitest run && npm run build && playwright test",
    "e2e": "playwright test",
    "gate": "trunk check --ci --no-fix --all && biome ci . && tsc --noEmit && markdownlint-cli2 && vitest run && npm run build && npm run e2e:smoke && git diff --exit-code -- dist",
    "e2e:smoke": "playwright test --grep @smoke",
    "maint": "depcruise --config .dependency-cruiser.cjs src web test && knip --no-progress && jscpd . --silent"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@hono/node-server": "2.1.11",
    "@hono/node-ws": "1.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@types/three": "0.186.0",
    "@xstate/react": "6.1.0",
    "chrome-launcher": "1.2.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "cross-spawn": "7.0.6",
    "fastest-levenshtein": "1.0.16",
    "hono": "4.13.20",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remove-markdown": "0.8.0",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "xstate": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "4.3.3",
    "@trunkio/launcher": "1.3.4",
    "@tsconfig/strictest": "2.0.9",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.9.0",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "markdownlint-cli2": "0.24.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  },
  "overrides": {
    "tar": "7.5.23",
    "minimatch": "11.0.9"
  }
}
